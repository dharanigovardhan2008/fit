# Supabase secrets - set these with `supabase secrets set --env-file backend/.env` after copying
# this file to backend/.env (git-ignored). Never commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign and verify daily attendance QR codes (attendance-qr and attendance-scan functions).
QR_SECRET=generate-a-long-random-string
